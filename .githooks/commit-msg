#!/usr/bin/env bash
# Commit message validation hook
# Copied from stanislas-poisson/php-dev-tools 1.0.0, which aligned on the commit convention of the zairakai handbook
# (policies/git-rules.md), which is the only convention of the zairakai tools:
#
#   <type>(<scope>): #TICKET <subject>
#
#   - type: feat, fix, docs, style, refactor, perf, test, chore, ci or build
#   - scope: optional, in lowercase
#   - #TICKET: the number of the issue
#   - the first line has 72 characters at most, and the second line is blank
#
# A work in progress follows the same format. The messages that Git writes itself
# (Merge, Revert, fixup!, squash!) are accepted as they are.
#
# To bypass (emergency only):
#   git commit --no-verify

commit_msg_file="$1"
first_line=$(sed -n 1p "$commit_msg_file")
second_line=$(sed -n 2p "$commit_msg_file")

case "$first_line" in
    "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

PATTERN='^(feat|fix|docs|style|refactor|perf|test|chore|ci|build)(\([a-z0-9][a-z0-9._/-]*\))?: #[0-9]+ [^[:space:]].*$'

fail() {
    echo ""
    echo "❌ $1"
    echo ""
    echo "  Format of the zairakai handbook:  <type>(<scope>): #TICKET <subject>"
    echo "  Types: feat, fix, docs, style, refactor, perf, test, chore, ci, build"
    echo ""
    echo "  Your message: \"$first_line\""
    echo ""
    echo "  Examples:"
    echo "    feat(auth): #102 add OAuth2 provider support"
    echo "    fix(api): #87 handle null response from payment gateway"
    echo "    docs: #31 update installation instructions"
    echo ""
    exit 1
}

if ! [[ $first_line =~ $PATTERN ]]; then
    fail "Invalid commit message format"
fi

if [[ ${#first_line} -gt 72 ]]; then
    fail "The first line has ${#first_line} characters: the limit is 72"
fi

if [[ -n $second_line ]]; then
    fail "The second line must be blank"
fi

echo "✅ Commit message OK"
exit 0
