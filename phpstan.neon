# PHPStan configuration (laravel-dev-tools, application mode)
# The package app.neon cannot be included as is: its Larastan include is relative to the package directory.
includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/zairakai/laravel-dev-tools/config/base.neon
    - config/dev-tools/baseline.neon

parameters:
    paths:
        - app
        - tests
    tmpDir: build/phpstan
    # Strict rules of php-dev-tools that this project does not follow yet. TEMPORARY: reduce this list rule by rule.
    ignoreErrors:
        -
            identifier: staticMethod.dynamicCall # $this->assertSame() in the tests
        -
            identifier: method.childReturnType
        -
            identifier: ternary.shortNotAllowed
        -
            identifier: ternary.condNotBoolean
        -
            identifier: booleanNot.exprNotBoolean
